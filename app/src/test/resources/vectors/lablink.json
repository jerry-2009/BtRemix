    },
    {
      "id": "L1-SPLITTER",
      "fixture": "lab.static",
      "classification": "data",
      "reason": "Closed by splitter.lengthPrefixed and direction-specific length segment flags",
      "proposedIn": "P1/P2"
    },
    {
      "id": "L1-WIDE-COMMAND",
      "fixture": "lab.static",
      "classification": "data",
      "reason": "Closed by the UInt24 Packet command and 1..3-byte command segment",
      "proposedIn": "P2"
    },
    {
      "id": "L1-DUAL-LAYOUT",
      "fixture": "lab.static",
      "classification": "data",
      "reason": "Closed by independent request and response segment tables",
      "proposedIn": "P2"
    },
    {
      "id": "L2-RFCOMM-SCRIPT",
      "fixture": "lab.reactive",
      "classification": "script",
      "reason": "Closed by SessionIo, bounded session opcodes, explicit triggers and initialization policy",
      "proposedIn": "P3"
    },
    {
      "id": "L3-EXTENSION-SPI",
      "fixture": "lab.authenticated",

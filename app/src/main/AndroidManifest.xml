<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Melody bridge (MELODY_BRIDGE_SPEC §6.4): the bridge session host is a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- The bridge notification is informational; without this grant the service still runs silently. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The bridge talks to com.oplus.melody; package visibility is required on API 30+. -->
    <queries>
        <package android:name="com.oplus.melody" />
    </queries>

    <application
        android:allowBackup="true"
        android:name=".BtRemixApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BtRemix">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BtRemix"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets LSPosed open the bridge entry point as this module's settings screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- Declared in M0; the AIDL binder and session wiring are implemented in M2. -->
        <service
            android:name=".melody.bridge.MelodySessionService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice" />

        <!--
          M5.4b: "the injected host process just came up" nudge. Disabled by default and only enabled
          by MelodySessionService while the bridge is running, so it can never cold-start BtRemix for
          nothing. The sender is com.oplus.melody, which cannot hold a BtRemix-declared permission;
          the receiver therefore grants nothing - it only makes us ring one extra doorbell, and every
          binder call the host makes afterwards is still UID-checked.
        -->
        <receiver
            android:name=".melody.bridge.MelodyHostHelloReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="com.Fusion.Btremix.melody.HOST_ALIVE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>

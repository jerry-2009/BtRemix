# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# --- Melody bridge (LSPosed) ---------------------------------------------------------------
# The libxposed framework loads the entry point by its exact class name from
# META-INF/xposed/java_init.list, so it and its no-argument constructor must survive R8.
-keep class com.Fusion.Btremix.melody.hook.MelodyBridgeEntry {
    public <init>();
}

# M1+ observation hooks are resolved from the entry point at runtime inside the host process.
-keep class com.Fusion.Btremix.melody.hook.** { *; }
-keep class com.Fusion.Btremix.melody.api.** { *; }

# Compiled AIDL types are looked up by interface name across the process boundary (M2+).
-keep interface com.Fusion.Btremix.melody.bridge.** { *; }
-keep class com.Fusion.Btremix.melody.bridge.** { *; }

# The Xposed API is compile-only; the runtime classes come from the framework.
-dontwarn io.github.libxposed.**
